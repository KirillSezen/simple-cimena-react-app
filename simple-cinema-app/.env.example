# Ваш API ключ сервиса TMDB, зарегистрируйтесь на официальном сайте TMDB и следуйте инструкциям чтобы получить данный ключ.
VITE_TMDB_API_KEY= your_tmdb_api_key

# Id вашего проекта, базы данных и коллекция в сервисе Appwrite, зарегистрируйтесь в сервисе и создайте свой проект, в нём сможете получить необходимые id.
VITE_APPWRITE_PROJECT_ID = your_appwrite_project_id
VITE_APPWRITE_DATABASE_ID = your_appwrite_database_id
VITE_APPWRITE_COLLECTION_ID = your_appwrite_collection_id